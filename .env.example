# Open-Meteo and Frankfurter do not require a key for the public endpoints used here.
# Obtain a Geoapify key at https://www.geoapify.com/ and keep it private.
TRIPPILOT_GEOAPIFY_API_KEY=your_geoapify_api_key
TRIPPILOT_APP_NAME=TripPilot API
TRIPPILOT_DEBUG=false
TRIPPILOT_REQUEST_TIMEOUT_SECONDS=5
TRIPPILOT_CACHE_TTL_SECONDS=300
TRIPPILOT_PROVIDER_RETRY_ATTEMPTS=2
TRIPPILOT_PROVIDER_RETRY_DELAY_SECONDS=0.1
TRIPPILOT_WEATHER_FORECAST_DAYS=7
TRIPPILOT_PLACES_RADIUS_METERS=5000

# Local Ollama is used for itinerary generation and conversations; no API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30

# Phase 4 conversation state is local to one backend process.
TRIPPILOT_CONVERSATION_HISTORY_LIMIT=12
TRIPPILOT_CONVERSATION_MAX_TOOL_CALLS=2

